# Stage 1 — compile TypeScript (needs devDeps for tsc)
FROM node:20-alpine AS builder

WORKDIR /app

COPY routing-service/package*.json ./
RUN npm ci

COPY routing-service/tsconfig.json ./
COPY routing-service/src ./src
RUN npm run build

# Stage 2 — production image (no devDeps, no source)
FROM node:20-alpine

WORKDIR /app

COPY routing-service/package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

# Baked routing data: gzipped graphs + small support JSON, staged by
# `npm run prepare:data` (routing-service/scripts/prepare-routing-data.mjs)
# into routing-service/data. The loader reads the .gz graphs directly, so the
# raw multi-GB map_data is never needed in the image or at runtime.
COPY routing-service/data /data

EXPOSE 3001

ENV MAP_DATA_PATH=/data
ENV PORT=3001
# All games' routing graphs are loaded into memory at startup (ETS2 + ProMods
# alone are ~700MB of raw JSON, several GB once parsed). Node's default
# old-space limit (~2GB) is not enough — raise it. Override via NODE_OPTIONS.
ENV NODE_OPTIONS=--max-old-space-size=8192

CMD ["node", "dist/server.js"]
