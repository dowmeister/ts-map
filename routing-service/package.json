{
  "name": "ts-map-routing-service",
  "version": "1.0.0",
  "description": "ETS2/ATS routing engine for Trucky",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node --max-old-space-size=8192 dist/server.js",
    "dev": "node --max-old-space-size=8192 -r ts-node/register src/server.ts",
    "prepare:data": "node scripts/prepare-routing-data.mjs",
    "debug:routes": "ts-node src/debug-routes.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
