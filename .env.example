# Port Configuration
TILESERVER_PORT=8080
WEBSERVER_PORT=5500
REACT_APP_PORT=3000

# Map Default Settings
VITE_MAP_DEFAULT_PITCH=20
VITE_MAP_DEFAULT_ZOOM=4
VITE_MAP_DEFAULT_BEARING=0
VITE_MAP_DEFAULT_CENTER_LON=0
VITE_MAP_DEFAULT_CENTER_LAT=0

# Map data CDN/origin.
# In production this should point to a Cloudflare-cached custom domain, not the
# raw R2 public endpoint, so Range requests for PMTiles can be cached at the edge.
VITE_MAP_DATA_URL=http://localhost:8888

# Bump this when deploying regenerated sprites. Leave empty in local dev.
# Auto-derived from VectorTileMapInfo.json's "version" field (set by the CLI
# export) when available; this is only used as a fallback/override.
VITE_MAP_ASSET_VERSION=

# Comma-separated list of games that have a pre-generated raster background
# pmtiles file (see README-VectorTiles.md step 4 - experimental). Leave empty
# to disable the raster background layer entirely.
VITE_MAP_BACKGROUND_GAMES=

# API Endpoints
# For production, point these to your CDN/tile server URLs
# Examples:
# VITE_VECTOR_TILES_BASE_URL=https://tiles.example.com/data
# VITE_OVERLAY_IMAGES_BASE_URL=https://cdn.example.com/map_data
VITE_VECTOR_TILES_BASE_URL=http://localhost:8080/data
VITE_OVERLAY_IMAGES_BASE_URL=/map_data
